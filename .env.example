# Tool SDK — Environment Variables
# Copy to .env and fill in the values you need. Never commit .env.

# =============================================================================
# SVM / Solana RPC
# =============================================================================
# JSON-RPC for Solana or any Solana-compatible SVM. Used by inspect, SPL
# gates, and registry reads. Flag --rpc-url wins over these.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SVM_RPC_URL=
# Optional: expected genesis hash (full getGenesisHash string) to pin the cluster.
# SVM_GENESIS_HASH=5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d
# Deployed SVM tool-registry program (base58). Unset until a program exists.
# SVM_TOOL_REGISTRY_PROGRAM_ID=

# =============================================================================
# Wallet signing — pick ONE provider. SVM never uses a raw Solana secret key.
# =============================================================================

# --- SVM: Privy Solana wallet (external signer; no hot key in this process) ---
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_SVM_WALLET_ID=

# --- EVM Option A: Privy ---
# PRIVY_WALLET_ID=

# --- EVM Option B: Turnkey (HSM-backed) ---
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# TURNKEY_ORGANIZATION_ID=
# TURNKEY_WALLET_ADDRESS=
# TURNKEY_RPC_URL=

# --- EVM Option C: Fireblocks (enterprise MPC) ---
# FIREBLOCKS_API_KEY=
# FIREBLOCKS_API_SECRET=
# FIREBLOCKS_VAULT_ID=
# FIREBLOCKS_ASSET_ID=
# FIREBLOCKS_MAX_POLL_ATTEMPTS=

# --- EVM Option D: Bankr ---
# BANKR_API_KEY=

# --- EVM Option E: Raw Private Key (local EVM dev only, NOT recommended) ---
# PRIVATE_KEY=

# =============================================================================
# EVM RPC endpoint
# =============================================================================
# RPC_URL=
